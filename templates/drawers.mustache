{{!
    This file is part of Moodle - http://moodle.org/
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}
<div id="page-wrapper" class="d-print-block">

    {{{ output.standard_top_of_body_html }}}

    {{! Barra superior UPTex/SAEC (marca, toggle de drawer, notificaciones, usuario) }}
    {{> theme_saec/navbar }}

    {{! Drawer izquierdo: menú principal UPTex (5 opciones núcleo), sustituye
        al árbol de índice de curso nativo en este mismo slot/posición. }}
    {{#showmainnav}}
        {{< theme_boost/drawer }}
            {{$id}}theme_saec-drawers-mainnav{{/id}}
            {{$drawerclasses}}drawer drawer-left {{#sidebaropen}}show{{/sidebaropen}}{{/drawerclasses}}
            {{$drawercontent}}
                {{> theme_saec/nav-drawer }}
            {{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-index{{/drawerpreferencename}}
            {{$drawerstate}}show-drawer-left{{/drawerstate}}
            {{$tooltipplacement}}right{{/tooltipplacement}}
            {{$closebuttontext}}{{#str}}closesidebar, theme_saec{{/str}}{{/closebuttontext}}
        {{/ theme_boost/drawer}}
    {{/showmainnav}}

    {{#hasblocks}}
        {{< theme_boost/drawer }}
            {{$id}}theme_boost-drawers-blocks{{/id}}
            {{$drawerclasses}}drawer drawer-right{{#blockdraweropen}} show{{/blockdraweropen}}{{/drawerclasses}}
            {{$drawercontent}}
                <div class="d-print-none">
                    {{{ addblockbutton }}}
                    {{{ sidepreblocks }}}
                </div>
            {{/drawercontent}}
            {{$drawerpreferencename}}drawer-open-block{{/drawerpreferencename}}
            {{! This line overrides theme_boost/drawer's own "forceopen"
                block, and a block override REPLACES the parent's content
                outright rather than falling back to it — a single
                true-only conditional here would render completely empty
                whenever the underlying value is false, instead of the
                parent's own literal zero default (confirmed by inspecting
                this template's actual compiled output). The pair of
                positive and negative branches below exists so the
                resulting data attribute always holds a real one-or-zero
                value, never an empty string, regardless of how forgiving
                the JS that later reads it happens to be about that
                distinction. }}
            {{$forceopen}}{{#forceblockdraweropen}}1{{/forceblockdraweropen}}{{^forceblockdraweropen}}0{{/forceblockdraweropen}}{{/forceopen}}
            {{$drawerstate}}show-drawer-right{{/drawerstate}}
            {{$tooltipplacement}}left{{/tooltipplacement}}
            {{$drawercloseonresize}}1{{/drawercloseonresize}}
            {{$closebuttontext}}{{#str}}closeblockdrawer, core{{/str}}{{/closebuttontext}}
        {{/ theme_boost/drawer}}
    {{/hasblocks}}

    <div id="page" data-region="mainpage" data-usertour="scroller" class="drawers {{#sidebaropen}}show-drawer-left{{/sidebaropen}} {{#blockdraweropen}}show-drawer-right{{/blockdraweropen}} drag-container">
        <div id="topofscroll" class="main-inner">
            {{! El toggle del drawer izquierdo (menú UPTex) vive en theme_saec/navbar;
                aquí sólo queda el toggle nativo del drawer de bloques. }}
            <div class="drawer-toggles d-flex">
                {{#hasblocks}}
                    <div class="drawer-toggler drawer-right-toggle ml-auto d-print-none">
                        <button
                            class="btn icon-no-margin"
                            data-toggler="drawers"
                            data-action="toggle"
                            data-target="theme_boost-drawers-blocks"
                            data-toggle="tooltip"
                            data-placement="right"
                            title="{{#str}}opendrawerblocks, core{{/str}}"
                        >
                            <span class="sr-only">{{#str}}opendrawerblocks, core{{/str}}</span>
                            <span class="dir-rtl-hide">{{#pix}}t/blocks_drawer, core{{/pix}}</span>
                            <span class="dir-ltr-hide">{{#pix}}t/blocks_drawer_rtl, core{{/pix}}</span>
                        </button>
                    </div>
                {{/hasblocks}}
            </div>

            {{{ output.full_header }}}

            {{#secondarymoremenu}}
                <div class="secondary-navigation d-print-none">
                    {{> core/moremenu}}
                </div>
            {{/secondarymoremenu}}

            <div id="page-content" class="pb-3 d-print-block">
                <div id="region-main-box">
                    {{! Solo muestra el menú de ajustes si realmente contiene HTML dentro }}
                    {{#regionmainsettingsmenu}}
                    <div id="region-main-settings-menu" class="d-print-none">
                        <div> {{{ regionmainsettingsmenu }}} </div>
                    </div>
                    {{/regionmainsettingsmenu}}

                    {{! --- INICIO: BANNER DE BIENVENIDA UPTEX/SAEC (sólo /my/) ---
                        Sin estilos inline, sin cifras de ejemplo: firstName y
                        dashboardkpi vienen de layout drawers.php (fullname y
                        conteo real de cursos), no de texto fijo. NOTA: nunca
                        escribas dos llaves de cierre seguidas dentro de un
                        comentario Mustache (ni siquiera entre comillas) — el
                        comentario termina en la primera ocurrencia, cierre
                        prematuro y fuga de texto literal al DOM. }}
                    {{^showstudentdashboard}}
                    {{^showteacherdashboard}}
                    {{^showadmindashboard}}
                    {{#isDashboard}}
                    <div class="uptex-card mb-4">
                        <div class="p-4">
                            <h4 class="mb-1">{{#str}} dashboardgreeting, theme_saec, {{firstName}} {{/str}}</h4>
                            {{#isTeacher}}
                                <p class="text-muted small mb-0">{{#str}} navgradebook, theme_saec {{/str}}</p>
                            {{/isTeacher}}
                            {{#isStudent}}
                                <p class="text-muted small mb-0">{{#str}} navmycourses, theme_saec {{/str}}</p>
                            {{/isStudent}}
                            {{#isAdmin}}
                                <p class="text-muted small mb-0">{{#str}} pluginname, theme_saec {{/str}}</p>
                            {{/isAdmin}}

                            {{#dashboardkpi}}
                                <div class="row mt-3">
                                    <div class="col-6 col-md-4 col-lg-3">
                                        {{> theme_saec/components/metric_card }}
                                    </div>
                                </div>
                            {{/dashboardkpi}}
                        </div>
                    </div>
                    {{/isDashboard}}
                    {{/showadmindashboard}}
                    {{/showteacherdashboard}}
                    {{/showstudentdashboard}}
                    {{! --- FIN: BANNER DE BIENVENIDA UPTEX/SAEC --- }}

                    <div id="region-main">
                        {{{ output.course_content_header }}}
                        {{#headercontent}}
                            {{> core/activity_header }}
                        {{/headercontent}}
                        {{#overflow}}
                            <div class="container-fluid tertiary-navigation">
                                <div class="navitem">
                                    {{> core/url_select}}
                                </div>
                            </div>
                        {{/overflow}}

                        <div class="uptex-content-wrapper">
                            {{#showstudentdashboard}}
                                {{{ studentdashboardhtml }}}
                            {{/showstudentdashboard}}
                            {{#showteacherdashboard}}
                                {{{ teacherdashboardhtml }}}
                            {{/showteacherdashboard}}
                            {{#showadmindashboard}}
                                {{{ admindashboardhtml }}}
                            {{/showadmindashboard}}
                            {{#showcoursespage}}
                                {{{ coursespagehtml }}}
                            {{/showcoursespage}}
                            {{#showteachercoursespage}}
                                {{{ teachercoursespagehtml }}}
                            {{/showteachercoursespage}}
                            {{#showadmincoursespage}}
                                {{{ admincoursespagehtml }}}
                            {{/showadmincoursespage}}
                            {{#showbadgespage}}
                                {{{ badgespagehtml }}}
                            {{/showbadgespage}}
                            {{#showanalyticspage}}
                                {{{ analyticspagehtml }}}
                            {{/showanalyticspage}}
                            {{#showgraderhubpage}}
                                {{{ graderhubpagehtml }}}
                            {{/showgraderhubpage}}
                            {{#showsettingspage}}
                                {{{ settingspagehtml }}}
                            {{/showsettingspage}}
                            {{#showcourseviewpage}}
                                {{{ courseviewheaderhtml }}}
                            {{/showcourseviewpage}}
                            {{#showteachercourseviewpage}}
                                {{{ teachercourseviewheaderhtml }}}
                            {{/showteachercourseviewpage}}
                            {{#showassignviewpage}}
                                {{{ assignheaderhtml }}}
                            {{/showassignviewpage}}
                            {{#showassignteachersummary}}
                                {{{ assignteachersummaryhtml }}}
                            {{/showassignteachersummary}}
                            {{#showboletasummary}}
                                {{{ boletasummaryhtml }}}
                            {{/showboletasummary}}
                            {{! output.main_content() does not return real page HTML — it
                                returns a one-time placeholder token. core_renderer::header()
                                renders this ENTIRE layout once, then does a raw string search
                                for that token to split the output into a "before" half (emitted
                                immediately) and an "after" half (emitted by footer()); whatever
                                /my/index.php echoes between its header()/footer() calls
                                (custom_block_region('content') — the user's own configured
                                blocks, e.g. Timeline/Calendar/Course overview) is spliced in at
                                exactly that point. If the token never appears anywhere in the
                                rendered layout, header() throws
                                "page layout file ... does not contain the main content
                                placeholder" — so this call MUST run unconditionally on every
                                execution path, never behind the showstudentdashboard guard.
                                For students this means their own configured blocks (if any)
                                still render below the custom dashboard above — themes cannot
                                suppress that from the layout alone without touching core. }}
                            {{#showcourseviewpage}}
                                <div class="saec-course-view-grid">
                                    <div class="saec-course-view-grid__main">
                            {{/showcourseviewpage}}
                            {{#showteachercourseviewpage}}
                                <div class="saec-teacher-course-view-grid">
                                    <div class="saec-teacher-course-view-grid__main">
                            {{/showteachercourseviewpage}}
                            {{#showassignviewpage}}
                                <div class="saec-assign-view-grid">
                                    <div class="saec-assign-view-grid__workspace">
                                        {{{ assignworkspacehtml }}}
                                    </div>
                                    <div class="saec-assign-view-grid__native">
                            {{/showassignviewpage}}
                            {{{ output.main_content }}}
                            {{#showcourseviewpage}}
                                    </div>
                                    <div class="saec-course-view-grid__sidebar">
                                        {{{ courseviewsidebarhtml }}}
                                    </div>
                                </div>
                            {{/showcourseviewpage}}
                            {{#showteachercourseviewpage}}
                                    </div>
                                    <div class="saec-teacher-course-view-grid__sidebar">
                                        {{{ teachercourseviewsidebarhtml }}}
                                    </div>
                                </div>
                            {{/showteachercourseviewpage}}
                            {{#showassignviewpage}}
                                    </div>
                                </div>
                            {{/showassignviewpage}}
                        </div>
                        {{{ output.activity_navigation }}}
                        {{{ output.course_content_footer }}}
                    </div>
                </div>
            </div>
        </div>
        {{> theme_boost/footer }}
    </div>
    {{{ output.standard_after_main_region_html }}}
</div>

{{{ messagedrawerhtml }}}
{{{ output.standard_end_of_body_html }}}
</body>
</html>
{{#js}}
M.util.js_pending('theme_boost/loader');
require(['theme_boost/loader', 'theme_boost/drawer'], function(Loader, Drawer) {
    Drawer.init();
    M.util.js_complete('theme_boost/loader');
});
{{/js}}