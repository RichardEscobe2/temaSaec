{{!
    @template theme_saec/forgot_password_card

    Institutional password-recovery assistance card — rendered by
    pages/forgot_password.php inside the same theme_saec/login page shell
    (layout/login.php, .uptex-login-card__form-inner) the credential form
    itself uses, via the 'login' pagelayout. Replaces core's native
    username/email search form entirely: there is no form here, no fields
    to submit, nothing that could ever reach the SMTP-dependent code path
    that throws cannotmailconfirm on this install. Just institutional
    guidance text, differentiated contact info for students vs. staff, and
    a single link back to the login page.

    Redesign pass: root class is now saec-admin-reset-card (a specific
    instance of the generic saec-auth-notice card shape any future
    auth-flow notice can reuse — see scss/saec/_forgot_password.scss) and
    the return button reuses the shared btn-saec-primary CTA class
    (scss/saec/_dashboard_shared.scss) instead of a one-off Bootstrap
    button, keeping the same button language the rest of the platform uses.

    Example context (json):
    {
        "loginurl": "https://example.org/login/index.php"
    }
}}
<div class="uptex-login-card__form-inner saec-auth-notice saec-admin-reset-card">
    <div class="saec-admin-reset-card__icon" aria-hidden="true">
        <i class="icon fa fa-shield"></i>
    </div>
    <h1 class="login-heading h3 saec-admin-reset-card__title">{{#str}} forgotpasswordinstitutionaltitle, theme_saec {{/str}}</h1>
    <p class="saec-admin-reset-card__message">{{#str}} forgotpasswordinstitutionalmessage1, theme_saec {{/str}}</p>
    <p class="saec-admin-reset-card__message">{{#str}} forgotpasswordinstitutionalmessage2, theme_saec {{/str}}</p>

    <div class="saec-admin-reset-card__support" role="group" aria-label="{{#str}} forgotpasswordsupportheading, theme_saec {{/str}}">
        <p class="saec-admin-reset-card__support-heading">{{#str}} forgotpasswordsupportheading, theme_saec {{/str}}</p>
        <div class="saec-admin-reset-card__support-item">
            <i class="icon fa fa-graduation-cap saec-admin-reset-card__support-icon" aria-hidden="true"></i>
            <div class="saec-admin-reset-card__support-text">
                <strong>{{#str}} forgotpasswordsupportstudentslabel, theme_saec {{/str}}</strong>
                <span>{{#str}} forgotpasswordsupportstudentscontact, theme_saec {{/str}}</span>
            </div>
        </div>
        <div class="saec-admin-reset-card__support-item">
            <i class="icon fa fa-desktop saec-admin-reset-card__support-icon" aria-hidden="true"></i>
            <div class="saec-admin-reset-card__support-text">
                <strong>{{#str}} forgotpasswordsupportstafflabel, theme_saec {{/str}}</strong>
                <span>{{#str}} forgotpasswordsupportstaffcontact, theme_saec {{/str}}</span>
            </div>
        </div>
    </div>

    <a href="{{{ loginurl }}}" class="btn-saec-primary saec-admin-reset-card__btn">
        <i class="icon fa fa-arrow-left" aria-hidden="true"></i>
        {{#str}} backtologin, theme_saec {{/str}}
    </a>
</div>
