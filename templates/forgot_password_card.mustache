{{!
    @template theme_saec/forgot_password_card

    Institutional password-recovery assistance card — rendered by
    pages/forgot_password.php inside the same theme_saec/login page shell
    (layout/login.php, .uptex-login-card__form-inner) the credential form
    itself uses, via the 'login' pagelayout. Replaces core's native
    username/email search form entirely: there is no form here, no fields
    to submit, nothing that could ever reach the SMTP-dependent code path
    that throws cannotmailconfirm on this install. Just institutional
    guidance text and a single link back to the login page.

    Example context (json):
    {
        "loginurl": "https://example.org/login/index.php"
    }
}}
<div class="uptex-login-card__form-inner uptex-forgot-password">
    <div class="uptex-forgot-password__icon" aria-hidden="true">
        <i class="icon fa fa-key"></i>
    </div>
    <h1 class="login-heading h3 mb-3 text-center">{{#str}} forgotpasswordinstitutionaltitle, theme_saec {{/str}}</h1>
    <p class="uptex-forgot-password__message">{{#str}} forgotpasswordinstitutionalmessage1, theme_saec {{/str}}</p>
    <p class="uptex-forgot-password__message">{{#str}} forgotpasswordinstitutionalmessage2, theme_saec {{/str}}</p>
    <a href="{{{ loginurl }}}" class="btn btn-primary btn-lg btn-block uptex-forgot-password__btn">
        {{#str}} backtologin, theme_saec {{/str}}
    </a>
</div>
