{{!
    @template theme_saec/student_dashboard

    Student Dashboard (/my/) main content — replaces core's block-based
    my_index content for logged-in users whom
    \theme_saec\dashboard\student_dashboard::is_student() identifies as
    students. Rendered into layout/drawers.php's page-content region (see
    templates/drawers.mustache, showstudentdashboard branch).

    NOTE: never write two closing braces in a row inside a Mustache comment
    (not even as part of a quoted tag name) — the comment ends at the first
    occurrence, causing a premature close and literal text leaking to the DOM.

    Structural parity target: stitch_uptex/mi_panel_de_alumno_actualizado.
    Every value is bound to the context array returned by
    \theme_saec\dashboard\student_dashboard::get_dashboard_context() (plus
    mycoursesurl/calendarurl, added by layout/drawers.php) — no hardcoded
    text or example numbers.

    Example context (json):
    {
        "firstname": "Alex",
        "avatarurl": "https://example.org/pluginfile.php/1/user/icon/f1.jpg",
        "greeting": "Bienvenido de nuevo, Alex",
        "haspending": true,
        "pendingmessage": "Tienes 3 entregas pendientes para esta semana.",
        "herotitle": "Panel del Alumno",
        "herosubtitle": "Bienvenido de nuevo, Alex García. Tienes 3 entregas pendientes para esta semana.",
        "pillicon": "fa-clock-o",
        "pilltext": "Proyecto Final: Fase 1 · Sistemas Operativos",
        "pillvariant": "warning",
        "actionlabel": "Entregar Tarea",
        "actionurl": "https://example.org/mod/assign/view.php?id=5",
        "ispurgeaction": false,
        "mycoursesurl": "https://example.org/my/courses.php",
        "calendarurl": "https://example.org/calendar/view.php",
        "hascourses": true,
        "courses": [
            {
                "id": 12, "fullname": "Ingeniería de Software II",
                "courseurl": "https://example.org/course/view.php?id=12",
                "hascourseimage": false, "courseimage": null,
                "hascompletiondata": true, "progresspercent": 85,
                "progresslabel": "12 de 14 módulos"
            }
        ],
        "kpis": [
            {
                "icon": "<i class=\"icon fa fa-table\" aria-hidden=\"true\"></i>",
                "iconvariant": "primary", "label": "Promedio General", "value": "9.4",
                "hasvaluesuffix": true, "valuesuffix": "/ 10", "hasfootnote": false
            }
        ],
        "hasdeadlines": true,
        "deadlines": [
            {
                "title": "Proyecto Final: Fase 1", "coursename": "Sistemas Operativos",
                "daytag": "HOY", "daynumber": 24, "isurgent": true,
                "hasclosingnote": true, "closingnote": "Cierra en 4 horas"
            }
        ],
        "hasbadges": true,
        "canexport": true,
        "badges": [
            {
                "title": "Advanced Python Programming",
                "imageurl": "https://example.org/pluginfile.php/1/badges/badgeimage/1/f1",
                "isverified": true, "ispending": false, "date": "Emitido: Oct 24, 2023"
            }
        ],
        "tasksurl": "https://example.org/theme/saec/pages/student_tasks.php",
        "boletaurl": "https://example.org/grade/report/overview/index.php",
        "badgesurl": "https://example.org/badges/mybadges.php",
        "quickcalendarurl": "https://example.org/calendar/view.php?view=month"
    }
}}
<div class="uptex-student-dashboard">
    {{> theme_saec/components/hero_banner }}

    <section class="uptex-dashboard-section mb-4">
        <div class="uptex-dashboard-section__header">
            <h2>{{#str}} academicsummaryheading, theme_saec {{/str}}</h2>
        </div>
        <div class="row">
            {{#kpis}}
                <div class="col-12 col-md-3 mb-4 mb-md-0">
                    {{> theme_saec/components/metric_card }}
                </div>
            {{/kpis}}
        </div>
    </section>

    <div class="saec-student-quickactions mb-4">
        <a href="{{{ tasksurl }}}" class="uptex-quickaction">
            <span class="uptex-quickaction__icon" aria-hidden="true"><i class="icon fa fa-list-alt"></i></span>
            <span class="uptex-quickaction__label">{{#str}} quickactionmytasks, theme_saec {{/str}}</span>
        </a>
        <a href="{{{ boletaurl }}}" class="uptex-quickaction">
            <span class="uptex-quickaction__icon" aria-hidden="true"><i class="icon fa fa-file-text-o"></i></span>
            <span class="uptex-quickaction__label">{{#str}} quickactionmyboleta, theme_saec {{/str}}</span>
        </a>
        <a href="{{{ badgesurl }}}" class="uptex-quickaction">
            <span class="uptex-quickaction__icon" aria-hidden="true"><i class="icon fa fa-shield"></i></span>
            <span class="uptex-quickaction__label">{{#str}} quickactionmybadges, theme_saec {{/str}}</span>
        </a>
        <a href="{{{ quickcalendarurl }}}" class="uptex-quickaction">
            <span class="uptex-quickaction__icon" aria-hidden="true"><i class="icon fa fa-calendar"></i></span>
            <span class="uptex-quickaction__label">{{#str}} quickactionmycalendar, theme_saec {{/str}}</span>
        </a>
    </div>

    <div class="row">
        <div class="col-12 col-lg-8">
            <section class="uptex-dashboard-section mb-4">
                <div class="uptex-dashboard-section__header">
                    <h2>{{#str}} coursesenrolledheading, theme_saec {{/str}}</h2>
                    <div class="uptex-dashboard-section__header-actions">
                        <div class="saec-view-switcher" data-saec-view-switcher role="group" aria-label="{{#str}} courseviewswitcherlabel, theme_saec {{/str}}">
                            <button type="button" class="saec-view-switcher__btn" data-saec-view-btn="grid" aria-pressed="true" title="{{#str}} courseviewgrid, theme_saec {{/str}}">
                                <i class="icon fa fa-th-large" aria-hidden="true"></i>
                            </button>
                            <button type="button" class="saec-view-switcher__btn" data-saec-view-btn="list" aria-pressed="false" title="{{#str}} courseviewlist, theme_saec {{/str}}">
                                <i class="icon fa fa-bars" aria-hidden="true"></i>
                            </button>
                        </div>
                        <a href="{{{ mycoursesurl }}}" class="uptex-dashboard-section__link">{{#str}} viewallcourses, theme_saec {{/str}}</a>
                    </div>
                </div>
                {{#hascourses}}
                    <div class="saec-courses-container saec-courses-container--grid" data-saec-courses-container>
                        {{#courses}}
                            {{> theme_saec/components/course_progress_card }}
                        {{/courses}}
                    </div>
                {{/hascourses}}
                {{^hascourses}}
                    <div class="uptex-dashboard-empty">{{#str}} nocoursesenrolled, theme_saec {{/str}}</div>
                {{/hascourses}}
            </section>
        </div>

        <div class="col-12 col-lg-4">
            <section class="uptex-dashboard-section uptex-dashboard-section--sidebar mb-4">
                <div class="uptex-dashboard-section__header">
                    <h2>{{#str}} upcomingdeadlinesheading, theme_saec {{/str}}</h2>
                </div>
                {{#hasdeadlines}}
                    <div class="uptex-deadline-list">
                        {{#deadlines}}
                            {{> theme_saec/components/deadline_item }}
                        {{/deadlines}}
                    </div>
                {{/hasdeadlines}}
                {{^hasdeadlines}}
                    <div class="uptex-dashboard-empty">{{#str}} nodeadlines, theme_saec {{/str}}</div>
                {{/hasdeadlines}}
                <a href="{{{ calendarurl }}}" class="btn btn-outline-primary btn-block mt-3">{{#str}} opencalendar, theme_saec {{/str}}</a>
            </section>

            <section class="uptex-dashboard-section uptex-dashboard-section--sidebar">
                <div class="uptex-dashboard-section__header">
                    <h2>{{#str}} mybackpackheading, theme_saec {{/str}}</h2>
                    {{#canexport}}
                        <span class="uptex-dashboard-section__hint">{{#str}} backpackexport, theme_saec {{/str}}</span>
                    {{/canexport}}
                </div>
                {{#hasbadges}}
                    <div class="uptex-badge-grid">
                        {{#badges}}
                            {{> theme_saec/components/credential_badge }}
                        {{/badges}}
                    </div>
                {{/hasbadges}}
                {{^hasbadges}}
                    <div class="uptex-dashboard-empty">{{#str}} nobadgesyet, theme_saec {{/str}}</div>
                {{/hasbadges}}
                {{#canexport}}
                    <button type="button" class="btn btn-secondary btn-block mt-3" disabled
                            title="{{#str}} backpackexportcredly, theme_saec {{/str}}">
                        {{#str}} backpackexportcredly, theme_saec {{/str}}
                    </button>
                {{/canexport}}
            </section>
        </div>
    </div>
</div>
{{#js}}
require(['jquery'], function($) {
    var STORAGE_KEY = 'saec_student_course_view';
    var container = document.querySelector('[data-saec-courses-container]');
    var switcher = document.querySelector('[data-saec-view-switcher]');
    if (!container || !switcher) {
        return;
    }

    var applyView = function(view) {
        container.classList.toggle('saec-courses-container--grid', view === 'grid');
        container.classList.toggle('saec-courses-container--list', view === 'list');
        switcher.querySelectorAll('[data-saec-view-btn]').forEach(function(btn) {
            var isactive = (btn.getAttribute('data-saec-view-btn') === view);
            btn.classList.toggle('saec-view-switcher__btn--active', isactive);
            btn.setAttribute('aria-pressed', isactive ? 'true' : 'false');
        });
    };

    var saved = null;
    try {
        saved = window.localStorage.getItem(STORAGE_KEY);
    } catch (e) {
        saved = null;
    }
    applyView(saved === 'list' ? 'list' : 'grid');

    switcher.querySelectorAll('[data-saec-view-btn]').forEach(function(btn) {
        btn.addEventListener('click', function() {
            var view = btn.getAttribute('data-saec-view-btn');
            applyView(view);
            try {
                window.localStorage.setItem(STORAGE_KEY, view);
            } catch (e) {
                // Private browsing / storage disabled — view still applies for this load, just doesn't persist.
            }
        });
    });
});
{{/js}}
