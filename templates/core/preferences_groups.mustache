{{!
    @template core/preferences_groups (theme_saec override)

    Fase 16 — Account Settings Portal. Overrides core's own
    lib/templates/preferences_groups.mustache (same template name, so
    Moodle's resolver picks this file automatically everywhere it's used —
    /user/preferences.php's category grid — with zero core file changes).

    Context is UNCHANGED from core's template: `groups` (preferences_group
    objects: title + nodes) and each node's `get_title`/`action`/
    `get_content` (navigation_node — Mustache invokes these as public
    method calls, same as core's own template does). Every native link/URL
    is preserved exactly; only the markup/classes changed — 3 flat cards
    become a tab bar + panels, activated by inline JS since Mustache alone
    has no per-loop index/first-item helper to key off of.
}}
<div class="saec-settings-tabs" role="tablist">
    {{#groups}}
        <button type="button" class="saec-settings-tabs__tab" role="tab" aria-selected="false">
            {{ title }}
        </button>
    {{/groups}}
</div>

<div class="saec-settings-panels">
    {{#groups}}
        <div class="saec-settings-panel d-none">
            <ul class="saec-settings-list">
                {{#nodes}}
                    <li class="saec-settings-list__item">
                        <a {{#get_title}}title="{{get_title}}"{{/get_title}} href="{{{action}}}">
                            <span>{{ get_content }}</span>
                            <i class="icon fa fa-chevron-right" aria-hidden="true"></i>
                        </a>
                    </li>
                {{/nodes}}
            </ul>
        </div>
    {{/groups}}
</div>
{{#js}}
require(['jquery'], function($) {
    // Suppress the native "Blogs" category site-wide (all 3 roles show it,
    // Admin/Teacher/Student alike — this isn't a per-role capability gate,
    // it's a deliberate UX simplification for this theme). A CSS-only fix
    // isn't viable here: "Blogs" sits at a different tab INDEX per role
    // (verified live — 3rd tab for Admin, 2nd for Teacher/Student, since
    // each role's own preferences_group list differs), so an nth-child rule
    // that hides the right tab for one role hides the wrong one for
    // another. Matching by the category's own title text, in the exact
    // script that already owns this template's tab/panel wiring, is the
    // only robust option — and still zero core hacks, since this whole
    // template already replaces core's own preferences_groups.mustache.
    $('.saec-settings-tabs__tab').each(function(index) {
        if ($(this).text().trim().toLowerCase().indexOf('blog') !== -1) {
            $('.saec-settings-panel').eq(index).remove();
            $(this).remove();
        }
    });

    var tabs = $('.saec-settings-tabs__tab');
    var panels = $('.saec-settings-panel');

    tabs.removeClass('active').attr('aria-selected', 'false').first().addClass('active').attr('aria-selected', 'true');
    panels.addClass('d-none').first().removeClass('d-none');

    tabs.on('click', function() {
        var index = tabs.index(this);
        tabs.removeClass('active').attr('aria-selected', 'false');
        $(this).addClass('active').attr('aria-selected', 'true');
        panels.addClass('d-none');
        panels.eq(index).removeClass('d-none');
    });
});
{{/js}}
