{{!
    @template theme_saec/components/credential_badge

    Single micro-credential/badge tile (.uptex-badge-credential, custom.scss
    Phase 1) for the "Mi Mochila de Insignias" / Credly integration view.
    Intended to be looped by a caller — wrap a badges section around a
    partial include of this template; that caller is responsible for its
    own empty-state fallback when the badge list is empty.

    Example context (json):
    {
        "imageurl": "https://example.org/pluginfile.php/1/badges/badge/1/f1.png",
        "title": "Advanced Python Programming",
        "department": "Depto. Ciencias de Datos",
        "isverified": true,
        "ispending": false,
        "date": "Emitido: Oct 24, 2023"
    }
}}
<div class="uptex-badge-credential {{#ispending}}uptex-badge-credential--pending{{/ispending}}">
    <div class="uptex-badge-credential__media">
        {{#imageurl}}
            <img src="{{{ imageurl }}}" alt="{{ title }}" loading="lazy">
        {{/imageurl}}
        {{#isverified}}
            <span class="uptex-badge-credential__verified" aria-hidden="true">&#10003;</span>
        {{/isverified}}
    </div>
    <p class="uptex-badge-credential__title">{{ title }}</p>
    {{#department}}
        <p class="uptex-badge-credential__dept">{{ department }}</p>
    {{/department}}
    {{#date}}
        <p class="uptex-badge-credential__date">{{ date }}</p>
    {{/date}}
</div>
