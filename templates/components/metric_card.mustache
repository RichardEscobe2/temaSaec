{{!
    @template theme_saec/components/metric_card

    Bento-style KPI card (.uptex-metric-card, custom.scss Phase 1). Used for
    the summary rows on the Calificador, Asistencia, Rendimiento Académico
    and Estudiantes y Progreso dashboards. Icon HTML is expected pre-rendered
    (e.g. via $OUTPUT->pix_icon()) and passed in as-is.

    Example context (json):
    {
        "icon": "<img src=\"https://example.org/pix/i/grades.svg\" alt=\"\">",
        "iconvariant": "accent",
        "label": "Promedio Grupal",
        "value": "8.4",
        "hasvaluesuffix": true,
        "valuesuffix": "/ 10",
        "hasfootnote": true,
        "footnote": "+4% vs parcial anterior",
        "hasurl": true,
        "url": "https://example.org/mod/attendance/view.php?id=31&mode=1"
    }

    hasurl/url are optional (default false/absent) — most metric_card call
    sites (Calificador, Rendimiento Académico summaries, etc.) pass neither
    and keep rendering as a plain, non-interactive tile exactly as before.

    valuemodifier is optional (default absent — no extra class) — e.g. "good"
    (green) / "warn" (amber) for the Student Dashboard's GPA badge; every
    other caller omits it and renders exactly as before.
}}
{{#hasurl}}<a href="{{{ url }}}" class="uptex-metric-card uptex-metric-card--link">{{/hasurl}}
{{^hasurl}}<div class="uptex-metric-card">{{/hasurl}}
    <div class="uptex-metric-card__icon {{#iconvariant}}uptex-metric-card__icon--{{ iconvariant }}{{/iconvariant}}" aria-hidden="true">
        {{{ icon }}}
    </div>
    <div class="uptex-metric-card__body">
        <p class="uptex-metric-card__label">{{ label }}</p>
        <p class="uptex-metric-card__value {{#valuemodifier}}uptex-metric-card__value--{{ valuemodifier }}{{/valuemodifier}}">
            {{ value }}
            {{#hasvaluesuffix}}<small>{{ valuesuffix }}</small>{{/hasvaluesuffix}}
        </p>
        {{#hasfootnote}}
            <p class="small text-muted mb-0 mt-1">{{ footnote }}</p>
        {{/hasfootnote}}
    </div>
{{#hasurl}}</a>{{/hasurl}}
{{^hasurl}}</div>{{/hasurl}}
